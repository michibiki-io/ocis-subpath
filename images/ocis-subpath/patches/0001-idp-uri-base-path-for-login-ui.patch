+func TestSubpathLoginPages(t *testing.T) {
+	for _, prefix := range []string{"", "/", "/ocis", "/team/files/"} {
+		t.Run(prefix, func(t *testing.T) {
+			_, srv := newTestService(t, func(cfg *config.Config) {
+				cfg.IDP.URIBasePath = prefix
+				cfg.Commons.OcisURL = ""
+			})
+			base := pathWithOptionalPrefix(prefix, "/signin/v1")
+			for _, page := range []string{"identifier", "identifier/", "identifier/index.html", "welcome", "goodbye", "consent", "loginerror", "chooseaccount"} {
+				code, body, _ := getPage(t, srv, base+"/"+page, "")
+				if code != http.StatusOK || !strings.Contains(body, base+"/static/theme.css") {
+					t.Errorf("page %s: status %d or missing prefixed CSS", page, code)
+				}
+			}
+			code, _, headers := getPage(t, srv, base+"/static/theme.css", "")
+			if code != http.StatusOK || headers.Get("Cache-Control") != "no-cache" {
+				t.Errorf("CSS: status %d, headers %v", code, headers)
+			}
+			code, _, _ = getPage(t, srv, base+"/static/", "")
+			if code != http.StatusNotFound {
+				t.Errorf("directory listing: status %d", code)
+			}
+			code, body, _ := getPage(t, srv, pathWithOptionalPrefix(prefix, "/.well-known/openid-configuration"), "")
+			if code != http.StatusOK || !strings.Contains(body, "issuer") {
+				t.Errorf("discovery: status %d, body %s", code, body)
+			}
+			client := &http.Client{CheckRedirect: func(req *http.Request, via []*http.Request) error { return http.ErrUseLastResponse }}
+			resp, err := client.Get(srv.URL + base + "/identifier?flow=consent&state=abc")
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer resp.Body.Close()
+			if got := resp.Header.Get("Location"); got != base+"/consent?flow=consent&state=abc" {
+				t.Errorf("consent redirect: %s", got)
+			}
+		})
+	}
+}
+
+func TestSubpathLoginLogo(t *testing.T) {
+	for _, logo := range []string{"themes/owncloud/assets/logo.svg", "/custom/logo.svg", "https://example.org/logo.svg", ""} {
+		t.Run(logo, func(t *testing.T) {
+			srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				if r.URL.Path != "/ocis/themes/owncloud/theme.json" {
+					t.Errorf("theme path: %s", r.URL.Path)
+				}
+				fmt.Fprintf(w, `{"common":{"logo":%q}}`, logo)
+			}))
+			defer srv.Close()
+			want := logo
+			if logo == "" {
+				want = "/ocis/themes/owncloud/assets/logo.svg"
+			}
+			if logo == "themes/owncloud/assets/logo.svg" {
+				want = "/ocis/" + logo
+			}
+			if got := fetchLoginLogoURL(srv.URL+"/ocis/", false); got != want {
+				t.Errorf("logo = %s, want %s", got, want)
+			}
+		})
+	}
+}
